// ===== 부트캠프 =====
model Bootcamp {
  id                Int            @id @default(autoincrement())
  name              String
  instructorName    String         @default("")
  description       String         @default("")
  thumbnail         String?
  startDate         DateTime?
  endDate           DateTime?
  status            BootcampStatus @default(PREPARING)
  recruitIntro      String         @default("")
  recruitCurriculum String         @default("")
  recruitReview     String         @default("")
  recruitInstructors  Json?
  interviewSettings   Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  courses    Course[]
  applicants Applicant[]
  notices    Notice[]
}

enum BootcampStatus {
  PREPARING
  RECRUITING
  OPERATING
  CLOSED
  ENDED
}
