// ===== 부트캠프 =====
model Bootcamp {
  id                Int            @id @default(autoincrement())
  name              String
  instructorName    String         @default("")
  description       String         @default("")
  thumbnail         String?
  startDate         DateTime?
  endDate           DateTime?
  status            BootcampStatus @default(PREPARING)
  recruitIntro      String         @default("")
  recruitCurriculum String         @default("")
  recruitReview     String         @default("")
  recruitInstructors  Json?
  interviewSettings   Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  courses      Course[]
  applicants   Applicant[]
  notices      Notice[]
  instructors  BootcampInstructor[]
}

enum BootcampStatus {
  PREPARING
  RECRUITING
  OPERATING
  CLOSED
  ENDED
}

// ===== 부트캠프-강사 관계 =====
model BootcampInstructor {
  id          Int      @id @default(autoincrement())
  bootcampId  Int
  userId      Int
  createdAt   DateTime @default(now())

  bootcamp    Bootcamp @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bootcampId, userId])
}
