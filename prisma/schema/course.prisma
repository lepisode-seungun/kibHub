// ===== 과정 =====
model Course {
  id         Int          @id @default(autoincrement())
  name       String
  status     CourseStatus @default(PENDING)
  sortOrder  Int          @default(0)
  bootcampId Int
  bootcamp   Bootcamp     @relation(fields: [bootcampId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  lectures    Lecture[]
  assignments Assignment[]
}

enum CourseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ===== 강의 =====
model Lecture {
  id        Int      @id @default(autoincrement())
  title     String
  category  String   @default("")
  videoUrl  String   @default("")
  content   String   @default("")
  sortOrder Int      @default(0)
  courseId   Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files     LectureFile[]
}

model LectureFile {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  size      Int      @default(0)
  mimeType  String   @default("")
  lectureId Int
  lecture   Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ===== 과제 =====
model Assignment {
  id        Int       @id @default(autoincrement())
  title     String
  content   String    @default("")
  videoUrl  String    @default("")
  dueDate   DateTime?
  courseId   Int
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  files       AssignmentFile[]
  submissions Submission[]
}

model AssignmentFile {
  id           Int        @id @default(autoincrement())
  name         String
  url          String
  size         Int        @default(0)
  mimeType     String     @default("")
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

// ===== 과제 제출 =====
model Submission {
  id           Int              @id @default(autoincrement())
  title        String
  content      String           @default("")
  type         SubmissionType   @default(SUBMISSION)
  assignmentId Int
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  authorId     Int
  author       User             @relation(fields: [authorId], references: [id])
  parentId     Int?
  parent       Submission?      @relation("SubmissionReplies", fields: [parentId], references: [id])
  replies      Submission[]     @relation("SubmissionReplies")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  files        SubmissionFile[]
  comments     SubmissionComment[]
}

enum SubmissionType {
  SUBMISSION
  FEEDBACK
}

model SubmissionFile {
  id           Int        @id @default(autoincrement())
  name         String
  url          String
  size         Int        @default(0)
  mimeType     String     @default("")
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}

model SubmissionComment {
  id           Int        @id @default(autoincrement())
  body         String
  authorId     Int
  author       User       @relation(fields: [authorId], references: [id])
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
}
